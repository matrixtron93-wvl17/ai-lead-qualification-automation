      "parameters": {
        "jsCode": "const aiText = $json.output[0].content[0].text;\n\nconst result = JSON.parse(aiText);\n\nconst lead = $('Prepare Lead Data').first().json;\n\nreturn [\n  {\n    json: {\n      ...lead,\n      qualification: result.qualification,\n      score: result.score,\n      reason: result.reason,\n      recommended_action: result.recommended_action\n    }\n  }\n];"
