    {
      "parameters": {
        "operation": "executeQuery",
        "query": "INSERT INTO lead_crm (\n    lead_id,\n    name,\n    email,\n    company,\n    qualification,\n    score,\n    lead_status,\n    follow_up_status,\n    last_contacted_at,\n    next_follow_up_at,\n    total_interactions,\n    company_size,\n    budget,\n    service,\n    timeline,\n    updated_at\n)\nVALUES (\n    '{{ $json.id }}',\n    '{{ $json.name }}',\n    '{{ $json.email }}',\n    '{{ $json.company }}',\n    '{{ $json.qualification }}',\n    {{ $json.score }},\n    '{{ $json.qualification === \"HOT\" || $json.qualification === \"WARM\" ? \"Qualified\" : \"Nurturing\" }}',\n    'Pending',\n    NULL,\n    NULL,\n    1,\n    {{ $json.company_size }},\n    {{ $json.budget }},\n    '{{ $json.service }}',\n    '{{ $json.timeline }}',\n    NOW()\n)\nON CONFLICT (email)\nDO UPDATE SET\n    lead_id = EXCLUDED.lead_id,\n    name = EXCLUDED.name,\n    company = EXCLUDED.company,\n    qualification = EXCLUDED.qualification,\n    score = EXCLUDED.score,\n    lead_status = EXCLUDED.lead_status,\n    follow_up_status = EXCLUDED.follow_up_status,\n    company_size = EXCLUDED.company_size,\n    budget = EXCLUDED.budget,\n    service = EXCLUDED.service,\n    timeline = EXCLUDED.timeline,\n    total_interactions = lead_crm.total_interactions + 1,\n    updated_at = NOW()\nRETURNING *;",
        "options": {}
      },
