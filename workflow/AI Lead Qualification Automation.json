        "html": "=<h2>New Lead Received</h2>\n\n<p><strong>Name:</strong> {{ $json.name }}</p>\n<p><strong>Email:</strong> {{ $json.email }}</p>\n<p><strong>Company:</strong> {{ $json.company }}</p>\n<p><strong>Company Size:</strong> {{ $json.company_size }}</p>\n<p><strong>Budget:</strong> ${{ $json.budget }}</p>\n<p><strong>Service:</strong> {{ $json.service }}</p>\n<p><strong>Timeline:</strong> {{ $json.timeline }}</p>\n\n<hr>\n\n<p><strong>Qualification:</strong> {{ $json.qualification }}</p>\n<p><strong>Score:</strong> {{ $json.score }}/100</p>\n\n<p><strong>AI Reason:</strong><br>\n{{ $('Parse AI Result').item.json.reason }}\n</p>\n\n<p><strong>Recommended Action:</strong><br>\n{{ $('Parse AI Result').item.json.recommended_action }}\n</p>",
